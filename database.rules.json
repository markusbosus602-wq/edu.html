{
  "rules": {

    "users": {
      "$uid": {
        ".read": true,
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "nicknames": {
      "$nick": {
        ".read": true,
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid)"
      }
    },

    "support": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "user_logs": {
      ".read": false,
      ".write": false
    },

    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
